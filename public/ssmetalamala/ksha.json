    {
      "id": "ksha-2",
      "text": "క్షణం తీరికలేదు దమ్మిడి ఆదాయం లేదు"
    },
    {
      "id": "ksha-3",
      "text": "క్షణం చిత్తం, క్షణం మాయ"
    },
    {
      "id": "ksha-4",
      "text": "క్షామమున జొన్న,వర్షమున వడ్లు పండును"
    },
    {
      "id": "ksha-5",
      "text": "క్షేత్రమెరిగి విత్తనం వెయ్యాలి, పాత్రమెరిగి దానం వెయ్యాలి"
    },
    {
      "id": "ksha-6",
      "text": "క్షేమంగా పోయి లాభంగా రండి"
    },
    {
      "id": "ksha-7",
      "text": "క్షీరాబ్ది లంకలో జేరినప్పటికైన, కొంగ తిండికి నత్తగుల్లలేను"
    }
  ]
