    {
      "id": "dha2-2",
      "text": "ధర్మో రక్షతి రక్షితః"
    },
    {
      "id": "dha2-3",
      "text": "ధనం మాట్లాడుతూ ఉంటే సత్యం మౌనం వహిస్తోంది"
    },
    {
      "id": "dha2-4",
      "text": "ధనానికి దాపరికం, సేద్యానికి వెల్లడి అవసరం"
    },
    {
      "id": "dha2-5",
      "text": "ధార లేని తిండి దయ్యపు తిండి"
    },
    {
      "id": "dha2-6",
      "text": "ధర తక్కువ బంగారానికి తళుకు లెక్కువ"
    },
    {
      "id": "dha2-7",
      "text": "ధైర్యే సాహసే లక్ష్మి"
    },
    {
      "id": "dha2-8",
      "text": "ధైర్యం లేని రాజు_యోచనలేని మంత్రి"
    }
