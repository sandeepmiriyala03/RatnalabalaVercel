  "items": [
    {
      "id": 1,
      "text": "శ"
    },
    {
      "id": 2,
      "text": "శంఖులో పోస్తేగాని తీర్థం కాదని"
    },
    {
      "id": 3,
      "text": "శృతి ముదిరి రాగాన పడింది"
    },
    {
      "id": 4,
      "text": "శుభం పలకరా పెళ్ళికొడకా అంటే పెళ్ళికూతురు ముండ ఎక్కడ చచ్చింది అన్నాడట"
    },
    {
      "id": 5,
      "text": "శుభం పలకరా పెళ్ళికొడకా అంటే పెళ్ళికొచ్చినోళ్లంతా నా పెద్దపెళ్లాలు అన్నాడట"
    },
    {
      "id": 6,
      "text": "శతకోటి దరిద్రాలకు అనంతకోటి ఉపాయాలు"
    },
    {
      "id": 7,
      "text": "శతకోటి లింగాలలో బోడిలింగం"
    },
    {
      "id": 8,
      "text": "శాస్త్రం ప్రకారం చేస్తే కుక్క పిల్లలు పుట్టాయంట"
    },
    {
      "id": 9,
      "text": "శివుని ఆజ్ఞ లేకుండా చీమైనా కుట్టదు"
    },
    {
      "id": 10,
      "text": "శ్వాస ఉండేవరకు ఆశ ఉంటుంది"
    },
    {
      "id": 11,
      "text": "శెనగలు తింటూ ఉలవలని చెప్పి పత్తివిత్తులు చేతిలో పెట్టినట్లు"
    },
    {
      "id": 12,
      "text": "శొంఠి లేని కషాయం లేదు"
    },
    {
      "id": 13,
      "text": "శ్వాస ఉండేవరకే ఆశ ఉంటుంది"
    }
  ]
